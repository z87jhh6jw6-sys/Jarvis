                  "name": "Superset curl marteau + curl inversé",
                  "scheme": "3 × 12 + 12",
                  "note": "Extrait de tes vidéos bras. Enchaîné sans repos, c'est tout le volume biceps dont tu as besoin en plus du mardi.",
                  "kind": "v",
                  "sets": 3,
                  "restSeconds": 90,
                  "timed": false
